<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="sensores.Pages.Demos.GpsCamaraPage"
             Title="Demo GPS + cámara">
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="12">
            <Label Text="Foto geoetiquetada" FontSize="22" FontAttributes="Bold" />

            <Border HeightRequest="340" StrokeThickness="1" StrokeShape="RoundRectangle 10"
                    Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}">
                <Grid>
                    <Label x:Name="Vacio" Text="Aún no hay foto" HorizontalOptions="Center" VerticalOptions="Center" Opacity="0.6" />
                    <Image x:Name="Foto" Aspect="AspectFit" />
                    <!-- Etiqueta superpuesta con las coordenadas -->
                    <Border x:Name="Etiqueta" IsVisible="False" VerticalOptions="End" Padding="10" StrokeThickness="0"
                            BackgroundColor="#AA000000">
                        <Label x:Name="EtiquetaLabel" TextColor="White" FontSize="13" />
                    </Border>
                </Grid>
            </Border>

            <Button x:Name="TomarButton" Text="📷  Tomar foto con ubicación" Clicked="OnTomar" />
            <Button x:Name="MapaButton" Text="🗺️  Abrir ubicación en el mapa" Clicked="OnMapa" IsEnabled="False" />

            <Label x:Name="Estado" FontSize="13" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
