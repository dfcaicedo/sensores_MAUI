<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="sensores.Pages.Demos.ArchivosPage"
             Title="Demo archivos">
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="12">
            <Label Text="1. Seleccionar un archivo" FontSize="22" FontAttributes="Bold" />

            <Picker x:Name="TipoPicker" Title="Tipo de archivo" SelectedIndex="0">
                <Picker.ItemsSource>
                    <x:Array Type="{x:Type x:String}">
                        <x:String>Cualquiera</x:String>
                        <x:String>Imágenes</x:String>
                        <x:String>PDF</x:String>
                        <x:String>Texto</x:String>
                    </x:Array>
                </Picker.ItemsSource>
            </Picker>
            <Button Text="📁  Elegir archivo" Clicked="OnElegir" />

            <Border x:Name="InfoBorder" IsVisible="False" Padding="14" StrokeShape="RoundRectangle 10"
                    Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}">
                <VerticalStackLayout Spacing="6">
                    <Label x:Name="InfoLabel" LineHeight="1.2" />
                    <Image x:Name="Vista" HeightRequest="200" Aspect="AspectFit" IsVisible="False" />
                    <Label x:Name="TextoLabel" FontSize="12" IsVisible="False" />
                </VerticalStackLayout>
            </Border>

            <BoxView HeightRequest="1" Color="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}" Margin="0,10" />

            <Label Text="2. Guardar y leer un archivo propio" FontSize="22" FontAttributes="Bold" />
            <Label Text="Se guarda en la carpeta privada de la app (FileSystem.AppDataDirectory)." FontSize="13" />
            <Editor x:Name="NotaEditor" Placeholder="Escribe una nota…" HeightRequest="100" AutoSize="TextChanges" />
            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                <Button Grid.Column="0" Text="💾  Guardar" Clicked="OnGuardar" />
                <Button Grid.Column="1" Text="📖  Leer" Clicked="OnLeer" />
            </Grid>
            <Label x:Name="Estado" FontSize="13" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
